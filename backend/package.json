{
  "name": "backend",
  "version": "1.0.0",
  "description": "Payload CMS 3 backend for Ignite Learning Academy",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/email-resend": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/plugin-cloud-storage": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/ui": "^3.92.0",
    "cloudinary": "^2.11.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "next": "15.5.28",
    "payload": "^3.92.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "^5.7.3"
  }
